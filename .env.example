# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR
# ==============================================================================
# Endereço/host onde o servidor Express irá rodar (ex: localhost ou 0.0.0.0)
ADRESS="localhost"

# Porta onde o servidor Express irá escutar requisições
PORT=3000


# ==============================================================================
# BANCOS DE DADOS
# ==============================================================================
# URL de conexão com o banco relacional MySQL/MariaDB (utilizado pelo Prisma)
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root:root@localhost:3306/plant_ai_mysql"

# URL de conexão com o banco NoSQL MongoDB (utilizado pelo Mongoose)
# Formato Local: mongodb://HOST:PORTA/NOME_DO_BANCO
# Formato Atlas: mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/NOME_DO_BANCO
MONGO_URL="mongodb://localhost:27017/plant_ai_mongo"


# ==============================================================================
# AUTENTICAÇÃO E SEGURANÇA
# ==============================================================================
# Chave secreta utilizada para assinar e validar os tokens JWT de autenticação
# Dica: gere uma string longa e segura para ambientes de produção
JWT_SECRET="seu_jwt_secret_super_secreto"


# ==============================================================================
# SERVIÇOS DE IA E RECONHECIMENTO DE PLANTAS
# ==============================================================================
# Chave de API do Google Gemini (utilizada para geração de respostas e insights de plantas)
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua_chave_da_api_gemini_aqui"

# Chave de API do Pl@ntNet (utilizada para identificação botânica por imagem)
# Obtenha sua chave registrando-se em: https://my.plantnet.org/
PLANTNET_API_KEY="sua_chave_da_api_plantnet_aqui"


# ==============================================================================
# SERVIÇO DE E-MAIL (SMTP - NODEMAILER)
# Utilizado para envio de e-mails de recuperação de senha
# ==============================================================================
# Host do servidor SMTP (ex: smtp.gmail.com ou sandbox.smtp.mailtrap.io para testes)
EMAIL_HOST="smtp.gmail.com"

# Porta do servidor SMTP (587 para TLS/STARTTLS, 465 para SSL ou 2525 para Mailtrap)
EMAIL_PORT=587

# Usuário/E-mail para autenticação no servidor SMTP
EMAIL_USER="seu_email@gmail.com"

# Senha de autenticação SMTP
# ATENÇÃO: No Gmail, utilize uma 'Senha de App' de 16 dígitos gerada em: https://myaccount.google.com/apppasswords
EMAIL_PASS="sua_senha_de_app_ou_smtp"

# Nome e e-mail que aparecerão como remetente
# Formato: "Nome de Exibição <email@dominio.com>"
EMAIL_FROM="Plant AI <seu_email@gmail.com>"
